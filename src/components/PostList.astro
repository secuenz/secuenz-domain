---
interface Props {
  posts: {
    id: string;
    data: { title: string; description: string; pubDate: Date; tags?: string[] };
  }[];
  /** URL prefix for each entry, e.g. '/blog/' */
  base: string;
  emptyMessage: string;
}

const { posts, base, emptyMessage } = Astro.props;
---

{posts.length === 0 ? (
    <div class="prose"><div class="callout">{emptyMessage}</div></div>
) : (
    <div class="grid-2">
        {posts.map((post) => (
            <a href={`${base}${post.id}/`} class="feature-card" style="text-decoration: none; display: block;">
                <span class="updated" style="margin-bottom: 12px;">
                    {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        timeZone: 'UTC',
                    })}
                </span>
                <h3 style="color: var(--text-main);">{post.data.title}</h3>
                <p>{post.data.description}</p>
                {post.data.tags && post.data.tags.length > 0 && (
                    <p style="margin-top: 16px;">
                        {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
                    </p>
                )}
            </a>
        ))}
    </div>
)}
