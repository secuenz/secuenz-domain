---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Set for pages that should stay out of search results (e.g. 404). */
  noindex?: boolean;
  /** Extra JSON-LD objects to embed in the head. */
  structuredData?: Record<string, unknown>[];
  /** Set false for detail pages that do not have a representative social image. */
  socialImage?: string | false;
}

const { title, description, noindex = false, structuredData = [], socialImage = '/og.png' } = Astro.props;

// Astro.site comes from `site` in astro.config.mjs, so canonicals stay
// absolute and correct without each page hardcoding the domain.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = socialImage ? new URL(socialImage, Astro.site).href : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    {noindex && <meta name="robots" content="noindex">}

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Secuenz">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    {ogImage && <meta property="og:image" content={ogImage}>}
    {ogImage && <meta property="og:image:width" content="1200">}
    {ogImage && <meta property="og:image:height" content="630">}
    {ogImage && <meta property="og:image:alt" content="ChaosEngine security assessment workflow interface by Secuenz">}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    {ogImage && <meta name="twitter:image" content={ogImage}>}
    {ogImage && <meta name="twitter:image:alt" content="ChaosEngine security assessment workflow interface by Secuenz">}

    <link rel="alternate" type="application/rss+xml" title="Secuenz Blog" href="/rss.xml">

    {structuredData.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
</head>
<body>

    <a class="skip-link" href="#main">Skip to main content</a>

    <div class="grid-bg"></div>

    <div class="container">
        <Nav />
        <main id="main">
            <slot />
        </main>
        <Footer />
    </div>

</body>
</html>
